/* Common source for the configure script to map target triples to:
 * - has_native_backend
 * - architecture
 * - model
 * - and operating system
 *
 * and for the compiler code to map strings for those last three elements to the
 * `derived_system` enumerated type. */

/* MATCH_TARGET(target pattern, has_native_backend, architecture, model, OS)
 * or
 * MATCH_TARGET_AND_64(target pattern, architecture 64, model 64,
 *                     architecture 32, model 32, OS)
 *
 * WARNING: the 32-bit architecture and model are ignored when generating the
 * OCaml match, as they are, at the moment, already covered before.
 */

/* In all the cases below, architecture = 'none' <=> OS = 'unknown' */

MATCH_TARGET(i[3456]86-*-linux*,no,i386,default,linux)
MATCH_TARGET(i[3456]86-*-freebsd*,no,i386,default,freebsd)
MATCH_TARGET(i[3456]86-*-netbsd*,no,i386,default,netbsd)
MATCH_TARGET(i[3456]86-*-openbsd*,no,i386,default,openbsd)
MATCH_TARGET(i[3456]86-*-haiku*,no,i386,default,beos)
MATCH_TARGET(i[3456]86-*-cygwin,no,i386,default,cygwin)
MATCH_TARGET(i[3456]86-w64-mingw32*,no,i386,default,mingw)
MATCH_TARGET(i[3456]86-*-gnu*,no,i386,default,gnu)
MATCH_TARGET(i686-pc-windows,no,i386,default,win32)
MATCH_TARGET(x86_64-pc-windows,yes,amd64,default,win64)
MATCH_TARGET(powerpc64le*-*-linux*,yes,power,ppc64le,linux)
MATCH_TARGET(powerpc64*-*-linux-musl*,yes,power,ppc64,linux)
MATCH_TARGET(s390x*-*-linux*,yes,s390x,z10,linux)
/* expected to match "gnueabihf" as well as "musleabihf" */
MATCH_TARGET(armv6*-*-linux-*eabihf|armv6*-*-linux-*eabi,no,arm,armv6,linux)
MATCH_TARGET(armv7*-*-linux-*eabihf|armv7*-*-linux-*eabi,no,arm,armv7,linux)
MATCH_TARGET(armv8*-*-linux-*eabihf|armv8*-*-linux-*eabi,no,arm,armv8,linux)
MATCH_TARGET(armv6t2*-*-linux-*eabi,no,arm,armv6t2,linux)
MATCH_TARGET(armv6*-*-freebsd*,no,arm,armv6,freebsd)
MATCH_TARGET(earmv6*-*-netbsd*,no,arm,armv6,netbsd)
MATCH_TARGET(earmv7*-*-netbsd*,no,arm,armv7,netbsd)
MATCH_TARGET(armv5te*-*-linux-*eabi,no,arm,armv5te,linux)
MATCH_TARGET(armv5*-*-linux-*eabi,no,arm,armv5,linux)
MATCH_TARGET(arm*-*-linux-*eabihf|arm*-*-linux-*eabi,no,arm,default,linux)
MATCH_TARGET(arm*-*-openbsd*|zaurus*-*-openbsd*,no,arm,default,openbsd)
MATCH_TARGET(x86_64-*-linux*,yes,amd64,default,linux)
MATCH_TARGET(x86_64-*-dragonfly*,no,amd64,default,dragonfly)
MATCH_TARGET(x86_64-*-solaris*,yes,amd64,default,solaris)
MATCH_TARGET(x86_64-*-freebsd*,yes,amd64,default,freebsd)
MATCH_TARGET(x86_64-*-netbsd*,yes,amd64,default,netbsd)
MATCH_TARGET(x86_64-*-openbsd*,yes,amd64,default,openbsd)
MATCH_TARGET(x86_64-*-haiku*,no,amd64,default,beos)
MATCH_TARGET(arm64-*-darwin*|aarch64-*-darwin*,yes,arm64,default,macosx)
MATCH_TARGET(x86_64-*-darwin*,yes,amd64,default,macosx)
MATCH_TARGET(x86_64-w64-mingw32*,yes,amd64,default,mingw64)
/* See the warning above */
MATCH_TARGET_AND_64(aarch64-*-linux*,arm64,default,arm,armv8,linux)
MATCH_TARGET(aarch64-*-freebsd*,yes,arm64,default,freebsd)
MATCH_TARGET(aarch64-*-openbsd*,yes,arm64,default,openbsd)
MATCH_TARGET(aarch64-*-netbsd*,yes,arm64,default,netbsd)
MATCH_TARGET(x86_64-*-cygwin,yes,amd64,default,cygwin)
MATCH_TARGET(riscv64-*-linux*,yes,riscv,riscv64,linux)
MATCH_TARGET(x86_64-*-gnu*,yes,amd64,default,gnu)
DEFAULT(no,none,default,unknown)
